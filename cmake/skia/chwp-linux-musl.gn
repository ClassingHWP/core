# Skia M157 (5b1a7f7c) GN 설정. Linux 정적(alpine, musl). Graphite Dawn(Vulkan)과 CPU 래스터를 둔다.
# GPU 장치가 없으면(정적 실행 파일은 Vulkan 드라이버를 열지 못한다) CPU 래스터로 그린다. 글꼴 관리자·이미지 코덱은 뺀다.
# tools/chwp-agent/package-skill.py 가 Docker 안에서 이 파일로 build/skia/out/chwp-linux-musl 을 만든다.
# partition_alloc 은 musl 에 없는 sys/cdefs.h 를 찾으므로 끈다(윈도우 MSVC 빌드도 쓰지 않는다).
is_debug = false
is_official_build = true
is_component_build = false
cc = "clang"
cxx = "clang++"
skia_enable_tools = false
skia_enable_ganesh = false
skia_enable_graphite = true
skia_use_gl = false
skia_use_dawn = true
dawn_enable_vulkan = true
skia_use_vulkan = false
skia_use_angle = false
skia_use_expat = false
skia_use_fontconfig = false
skia_use_freetype = false
skia_use_harfbuzz = false
skia_use_icu = false
skia_use_libjpeg_turbo_decode = false
skia_use_libjpeg_turbo_encode = false
skia_use_libpng_decode = false
skia_use_libpng_encode = false
skia_use_libwebp_decode = false
skia_use_libwebp_encode = false
skia_use_lua = false
skia_use_piex = false
skia_use_wuffs = false
skia_use_xps = false
skia_use_zlib = false
skia_use_dng_sdk = false
skia_enable_pdf = false
skia_enable_skottie = false
skia_enable_svg = false
skia_use_perfetto = false
skia_enable_spirv_validation = false
skia_use_partition_alloc = false
